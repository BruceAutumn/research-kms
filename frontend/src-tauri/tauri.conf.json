{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Research KMS",
  "version": "0.5.0",
  "identifier": "com.researchkms.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Research KMS",
        "url": "https://research-kms-workspace.huangqiuhao672790.chatgpt.site/app",
        "width": 1440,
        "height": 920,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Literature, AI and linked notes in one research workspace",
    "longDescription": "A research knowledge workspace combining literature management, tool-using AI and a Markdown knowledge vault.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
