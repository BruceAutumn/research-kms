{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-kms.example/schemas/plugin-manifest-v1.json",
  "title": "Research KMS declarative plugin manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "kind", "entry", "permissions", "domains"],
  "properties": {
    "schemaVersion": { "const": 1, "default": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,79}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "publisher": { "type": "string", "maxLength": 120 },
    "kind": { "enum": ["http-tool", "metadata-source", "exporter", "ui-link"] },
    "entry": { "type": "string", "format": "uri", "pattern": "^https://" },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["papers:read", "annotations:read", "notes:read", "metadata:write", "exports:write", "network:https"] }
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(?:\\*\\.)?[A-Za-z0-9.-]+$" }
    },
    "privacyUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "signature": { "type": "string", "minLength": 32 },
    "publicKey": { "type": "string", "minLength": 32 }
  }
}
