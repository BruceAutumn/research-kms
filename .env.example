# API Key encryption key (Base64-encoded 32-byte AES-256 key)
# Auto-generated on first run at ~/.kms/secret.key
# KMS_SECRET_KEY=

# CORS whitelist (comma-separated)
# APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:[*],http://127.0.0.1:[*]

# Use mock LLM (no real API calls)
# MOCK_LLM=false

# PDF storage directory
# PDF_STORAGE_DIR=./data/pdfs

# Vault root directory
# VAULT_ROOT=./data/vault

# Database
# POSTGRES_USER=kms
# POSTGRES_PASSWORD=kms