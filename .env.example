# PostgreSQL / pgvector
POSTGRES_USER=kms
POSTGRES_PASSWORD=kms
POSTGRES_PORT=5432
DATABASE_URL=jdbc:postgresql://localhost:5432/kms

# Local data directories (resolved from backend/ when started there)
VAULT_ROOT=./data/vault
PDF_STORAGE_DIR=./data/pdfs

# Set true for a no-cost local demo; set false before using a configured provider.
MOCK_LLM=false

# Safety guard: keep "local" until identity, tenant isolation, quotas and
# account deletion/export are implemented and reviewed.
APP_DEPLOYMENT_MODE=local

# Optional. Generate with: openssl rand -base64 32
# KMS_SECRET_KEY=

# Vite development proxy
VITE_API_TARGET=http://localhost:8080
# Required only for bundled Windows/Android clients. Never put an API key here.
# VITE_API_BASE_URL=https://api.example.com/api
